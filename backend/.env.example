# ============================================================================
# AXIOM backend — environment template. Copy to `backend/.env` (or set these as
# Railway service variables) and fill in real values.
# ============================================================================

# ---- Core infra (Railway injects DATABASE_URL automatically) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/axiom

# ---- Auth ----
# AXIOM has NO login. Leave APP_TOKEN empty to keep the API open (default).
# Set it to a long random string to re-enable single-user bearer-token protection.
APP_TOKEN=

# ---- OpenRouter (the ONLY key AXIOM needs for AI) --------------------------
# Bring your own OpenRouter key. Model defaults to a cheap DeepSeek.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Generous safety caps (DeepSeek is cheap). Lower these to cap spend.
AI_TOKEN_BUDGET=100000000
AI_DAILY_TOKEN_BUDGET=2000000
AI_BRIEF_ENABLED=false

# ---- Financial Modeling Prep (fundamentals; 250 calls/day on free tier) ----
FMP_API_KEY=your_fmp_key
FMP_DAILY_LIMIT=250

# ---- Finnhub (optional — earnings/insiders/news, 60 calls/min) ----
FINNHUB_API_KEY=
FINNHUB_PER_MIN=60

# ---- Polygon (optional — real-time quotes + whole-market daily bars, 5/min) ----
# grouped-daily returns EVERY US stock's bar for one date in a single request, so
# a day of history costs 1 call no matter how many tickers need it. A year is ~260
# calls, which the free 5/min tier can't do inline (~50 min) — raise POLYGON_PER_MIN
# on a paid tier to make it usable as the bars provider.
POLYGON_API_KEY=
POLYGON_PER_MIN=5
POLYGON_PER_DAY=7200

# ---- SEC EDGAR (no key; requires a descriptive User-Agent with contact email) ----
SEC_USER_AGENT=AXIOM Research 01dominique.c@gmail.com

# ---- FRED (St. Louis Fed) — FREE key, powers the macro backdrop (optional) ----
FRED_API_KEY=

# ---- Embeddings (local ONNX model -> pgvector; no external key needed) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Scanner defaults (tunable — "most possible" universe) ----
UNIVERSE_MIN_PRICE=3
UNIVERSE_MIN_AVG_DOLLAR_VOLUME=1000000
UNIVERSE_MIN_MARKET_CAP=100000000
SCAN_TECHNICAL_KEEP=300         # how many technical survivors get fundamental enrichment
SCAN_TOP_N=100                  # final ranked "best stocks" list size
# Who serves price history: auto | yahoo | polygon | fmp.
# 'auto' walks the failover chain (yahoo -> polygon -> fmp) and trips a hanging
# provider out of rotation for 15min. Pin this to 'fmp' or 'polygon' to take Yahoo
# out of the path entirely — the right move once Yahoo has rate-limited this IP
# range, because that penalty outlasts any retry or concurrency tuning.
SCAN_BARS_PROVIDER=auto

# ---- App / CORS ----
ENV=development
LOG_LEVEL=INFO
# Comma-separated allowlist of browser origins, or "*" for any (default).
FRONTEND_ORIGIN=*
